import matplotlib.pyplot as plt
import numpy as np

# Set figure and style
fig, ax = plt.subplots(figsize=(10, 6), dpi=120)

# -----------------------------------------------------------------------------
# 1. Generate Characteristic Data
# -----------------------------------------------------------------------------

# --- Standard p-n Diode ---
# Reverse breakdown at -40V, constant leakage, series-resistance limited forward
v_pn_rev = np.linspace(-50, 0, 400)
i_pn_rev = np.where(
    v_pn_rev < -40,
    -1.5 - 0.4 * (-40 - v_pn_rev) ** 1.8,  # Avalanche breakdown
    -1.5,  # Constant saturation current I_0
)

v_pn_fwd = np.linspace(0, 1.2, 200)
# Exponential turn-on transitioning to ohmic bulk resistance slope
i_pn_fwd = np.where(
    v_pn_fwd < 0.65,
    1.5 * (np.exp(v_pn_fwd / 0.12) - 1),
    1.5 * (np.exp(0.65 / 0.12) - 1) + 25 * (v_pn_fwd - 0.65),
)

# --- n+-n-p Junction Diode ---
# Higher breakdown at -80V, sqrt(V_R) leakage, conductivity-modulated forward
v_nnp_rev = np.linspace(-95, 0, 600)
i_nnp_rev = np.where(
    v_nnp_rev < -80,
    -1.5 * np.sqrt(1 + 80) - 0.4 * (-80 - v_nnp_rev) ** 1.8,  # Reach-through/Avalanche
    -1.5 * np.sqrt(1 + np.abs(v_nnp_rev)),  # Depletion-width generation leakage
)

v_nnp_fwd = np.linspace(0, 1.2, 200)
# Steeper slope at high injection due to conductivity modulation
i_nnp_fwd = np.where(
    v_nnp_fwd < 0.65,
    1.5 * (np.exp(v_nnp_fwd / 0.12) - 1),
    1.5 * (np.exp(0.65 / 0.12) - 1) + 50 * (v_nnp_fwd - 0.65),
)

# -----------------------------------------------------------------------------
# 2. Plot Curves
# -----------------------------------------------------------------------------

# Combine segments for continuous plotting
v_pn = np.concatenate([v_pn_rev, v_pn_fwd])
i_pn = np.concatenate([i_pn_rev, i_pn_fwd])

v_nnp = np.concatenate([v_nnp_rev, v_nnp_fwd])
i_nnp = np.concatenate([i_nnp_rev, i_nnp_fwd])

ax.plot(
    v_pn,
    i_pn,
    label=r"Standard $p-n$ Diode",
    color="#d62728",
    linewidth=2.2,
    linestyle="--",
)
ax.plot(
    v_nnp,
    i_nnp,
    label=r"$n^+-n-p$ Junction Diode",
    color="#1f77b4",
    linewidth=2.5,
)

# -----------------------------------------------------------------------------
# 3. Add Axes and Formatting
# -----------------------------------------------------------------------------

# Move spines to center (origin)
ax.spines["left"].set_position("zero")
ax.spines["bottom"].set_position("zero")
ax.spines["right"].set_color("none")
ax.spines["top"].set_color("none")

# Axis Limits
ax.set_xlim(-100, 1.4)
ax.set_ylim(-18, 18)

# Custom tick marks (Hide default numerical values for conceptual clarity)
ax.set_xticks([ -80, -40, 0, 0.7])
ax.set_xticklabels([r"$-V_{BR(n^+np)}$", r"$-V_{BR(pn)}$", "0", r"$V_\gamma$"], fontsize=11)
ax.set_yticks([])

# Axis Labels
ax.text(1.35, 1.5, r"Voltage ($V$)", fontsize=11, fontweight="bold")
ax.text(2, 16.5, r"Current ($I$)", fontsize=11, fontweight="bold")

# -----------------------------------------------------------------------------
# 4. Annotations for Key Physical Differences
# -----------------------------------------------------------------------------

# Forward Bias: Conductivity Modulation
ax.annotate(
    "Conductivity Modulation\n(Steeper slope at high current)",
    xy=(1.05, 14),
    xytext=(0.3, 13),
    arrowprops=dict(facecolor="#1f77b4", edgecolor="none", shrink=0.08, width=1.5, headwidth=6),
    fontsize=9.5,
    color="#1f77b4",
    fontweight="bold",
)

# Reverse Bias: Higher Breakdown Voltage
ax.annotate(
    "Higher Breakdown Voltage\n(Reach-Through / Avalanche)",
    xy=(-80, -3),
    xytext=(-95, -12),
    arrowprops=dict(facecolor="#1f77b4", edgecolor="none", shrink=0.08, width=1.5, headwidth=6),
    fontsize=9.5,
    color="#1f77b4",
    fontweight="bold",
)

# Reverse Bias: Generation Leakage
ax.annotate(
    r"Generation Leakage ($\propto \sqrt{V_R}$)",
    xy=(-40, -10),
    xytext=(-65, -6),
    arrowprops=dict(facecolor="#1f77b4", edgecolor="none", shrink=0.08, width=1.5, headwidth=6),
    fontsize=9.5,
    color="#1f77b4",
)

# Grid and Legend
ax.grid(True, linestyle=":", alpha=0.6)
ax.legend(loc="upper left", frameon=True, facecolor="white", edgecolor="none", fontsize=11)

plt.title(
    r"I-V Characteristics: $n^+-n-p$ Diode vs. Standard $p-n$ Diode",
    fontsize=13,
    pad=20,
    fontweight="bold",
)
plt.tight_layout()
plt.show()